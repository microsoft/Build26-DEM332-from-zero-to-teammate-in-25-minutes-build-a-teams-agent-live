# Optional. If omitted, the demo uses a deterministic mock PM response.
# Azure OpenAI is preferred when these are set.
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_MODEL=gpt-4o-mini

# Or use regular OpenAI instead.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Server port for the Vite + API app
PORT=3978

# Vite hot-module-reload websocket port for dev mode
VITE_HMR_PORT=3979
